# Triton config template for the XFeat sparse detector exported by export_xfeat_onnx.py.
# <H> <W> <K> are filled in by publish_xfeat_triton.py (-1 for H/W = any multiple of 32).
#
# No `name`: Triton takes the model name from its repository directory, which the MLflow Triton plugin
# names after `mlflow deployments create --name`.
# max_batch_size 0: `threshold` is (1,) for the whole batch and has no batch dimension Triton could add,
# so the batch dimension is part of the dims and the client sends all tiles of a frame in one request.
platform: "onnxruntime_onnx"
backend: "onnxruntime"
max_batch_size: 0
input [
  {
    name: "image"
    data_type: TYPE_FP32
    dims: [ -1, 1, <H>, <W> ]
  },
  {
    name: "threshold"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]
output [
  {
    name: "keypoints"
    data_type: TYPE_FP32
    dims: [ -1, <K>, 2 ]
  },
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [ -1, <K> ]
  },
  {
    name: "descriptors"
    data_type: TYPE_FP32
    dims: [ -1, <K>, 64 ]
  }
]
